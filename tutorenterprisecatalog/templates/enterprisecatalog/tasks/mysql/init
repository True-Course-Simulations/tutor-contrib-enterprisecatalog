echo "enterprisecatalog mysql: ensuring database exists"
mysql -u {{ MYSQL_ROOT_USERNAME }} --password="{{ MYSQL_ROOT_PASSWORD }}" --host "{{ MYSQL_HOST }}" --port {{ MYSQL_PORT }} -e 'CREATE DATABASE IF NOT EXISTS {{ ENTERPRISECATALOG_MYSQL_DATABASE }};'
echo "enterprisecatalog mysql: granting user access"
mysql -u {{ MYSQL_ROOT_USERNAME }} --password="{{ MYSQL_ROOT_PASSWORD }}" --host "{{ MYSQL_HOST }}" --port {{ MYSQL_PORT }} -e "CREATE USER IF NOT EXISTS '{{ ENTERPRISECATALOG_MYSQL_USERNAME }}'@'%' IDENTIFIED BY '{{ ENTERPRISECATALOG_MYSQL_PASSWORD }}';"
mysql -u {{ MYSQL_ROOT_USERNAME }} --password="{{ MYSQL_ROOT_PASSWORD }}" --host "{{ MYSQL_HOST }}" --port {{ MYSQL_PORT }} -e "ALTER USER '{{ ENTERPRISECATALOG_MYSQL_USERNAME }}'@'%' IDENTIFIED BY '{{ ENTERPRISECATALOG_MYSQL_PASSWORD }}';"
mysql -u {{ MYSQL_ROOT_USERNAME }} --password="{{ MYSQL_ROOT_PASSWORD }}" --host "{{ MYSQL_HOST }}" --port {{ MYSQL_PORT }} -e "GRANT ALL PRIVILEGES ON {{ ENTERPRISECATALOG_MYSQL_DATABASE }}.* TO '{{ ENTERPRISECATALOG_MYSQL_USERNAME }}'@'%';"
mysql -u {{ MYSQL_ROOT_USERNAME }} --password="{{ MYSQL_ROOT_PASSWORD }}" --host "{{ MYSQL_HOST }}" --port {{ MYSQL_PORT }} -e 'FLUSH PRIVILEGES;'

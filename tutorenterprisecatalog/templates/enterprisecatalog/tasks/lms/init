dockerize -wait tcp://{{ MYSQL_HOST }}:{{ MYSQL_PORT }} -timeout 20s

# Enterprise service worker configuration
ENTERPRISE_WORKER_USERNAME="{{ ENTERPRISE_SERVICE_WORKER_USERNAME | default('enterprise_worker', true) }}"
ENTERPRISE_WORKER_EMAIL="${ENTERPRISE_WORKER_USERNAME}@openedx"

echo "enterprisecatalog lms init: syncing enterprise worker user email"
./manage.py lms shell <<PY
from django.contrib.auth import get_user_model
User = get_user_model()
user = User.objects.filter(username='${ENTERPRISE_WORKER_USERNAME}').first()
target_email='${ENTERPRISE_WORKER_EMAIL}'
if user and user.email != target_email:
    user.email = target_email
    user.save()
PY

echo "enterprisecatalog lms init: ensuring enterprise worker user exists"
./manage.py lms manage_user ${ENTERPRISE_WORKER_USERNAME} ${ENTERPRISE_WORKER_EMAIL} --staff --superuser --unusable-password

echo "enterprisecatalog lms init: configuring ENTERPRISE_SERVICE_WORKER_USERNAME"
./manage.py lms shell <<PY
from django.contrib.sites.models import Site
try:
    from openedx.core.djangoapps.site_configuration.models import SiteConfiguration
except ImportError:
    SiteConfiguration = None

if SiteConfiguration:
    site = Site.objects.get_current()
    site_config, _ = SiteConfiguration.objects.get_or_create(site=site)
    values = dict(site_config.site_values or {})
    override = '${ENTERPRISE_WORKER_USERNAME}'
    if values.get('ENTERPRISE_SERVICE_WORKER_USERNAME') != override:
        values['ENTERPRISE_SERVICE_WORKER_USERNAME'] = override
        site_config.site_values = values
        site_config.save()
else:
    print('SiteConfiguration unavailable; skipping ENTERPRISE_SERVICE_WORKER_USERNAME override')
PY

echo "enterprisecatalog lms init: syncing service user email"
./manage.py lms shell -c \
    "from django.contrib.auth import get_user_model;\
    get_user_model().objects.filter(username='enterprisecatalog').exclude(email='enterprisecatalog@openedx').update(email='enterprisecatalog@openedx')"

echo "enterprisecatalog lms init: ensuring service user exists"
./manage.py lms manage_user enterprisecatalog enterprisecatalog@openedx --staff --superuser --unusable-password

# Development client
echo "enterprisecatalog lms init: creating dev OAuth clients"
./manage.py lms create_dot_application \
    --grant-type client-credentials \
    --redirect-uris "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ ENTERPRISECATALOG_HOST }}:8160/complete/edx-oauth2/" \
    --client-id {{ ENTERPRISECATALOG_OAUTH2_KEY_DEV }} \
    --client-secret {{ ENTERPRISECATALOG_OAUTH2_SECRET_DEV }} \
    --scopes user_id \
    --skip-authorization \
    --update \
    enterprisecatalog-dev \
    enterprisecatalog
./manage.py lms create_dot_application \
    --grant-type authorization-code \
    --redirect-uris "http://{{ ENTERPRISECATALOG_HOST }}:8160/complete/edx-oauth2/" \
    --client-id {{ ENTERPRISECATALOG_OAUTH2_KEY_SSO_DEV }} \
    --client-secret {{ ENTERPRISECATALOG_OAUTH2_SECRET_SSO_DEV }} \
    --scopes user_id \
    --skip-authorization \
    --update \
    enterprisecatalog-sso-dev \
    enterprisecatalog

# Production client
echo "enterprisecatalog lms init: creating prod OAuth clients"
./manage.py lms create_dot_application \
    --grant-type client-credentials \
    --redirect-uris "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ ENTERPRISECATALOG_HOST }}/complete/edx-oauth2/" \
    --client-id {{ ENTERPRISECATALOG_OAUTH2_KEY }} \
    --client-secret {{ ENTERPRISECATALOG_OAUTH2_SECRET }} \
    --scopes user_id \
    --skip-authorization \
    --update \
    enterprisecatalog \
    enterprisecatalog
./manage.py lms create_dot_application \
    --grant-type authorization-code \
    --redirect-uris "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ ENTERPRISECATALOG_HOST }}/complete/edx-oauth2/" \
    --client-id {{ ENTERPRISECATALOG_OAUTH2_KEY_SSO }} \
    --client-secret {{ ENTERPRISECATALOG_OAUTH2_SECRET_SSO }} \
    --scopes user_id \
    --skip-authorization \
    --update \
    enterprisecatalog-sso \
    enterprisecatalog

echo "enterprisecatalog lms init: enabling waffle sample use_enterprise_catalog"
(./manage.py lms waffle_sample --list | grep use_enterprise_catalog) || ./manage.py lms waffle_sample --create use_enterprise_catalog 100

echo "enterprisecatalog lms init: show enterprise app migrations"
./manage.py lms showmigrations enterprise

{% set ENTERPRISECATALOG_IMAGE = ENTERPRISECATALOG_DOCKER_IMAGE or ENTERPRISECATALOG_BUILT_IMAGE %}
enterprisecatalog:
  image: {{ ENTERPRISECATALOG_IMAGE }}
  environment:
    DJANGO_SETTINGS_MODULE: enterprise_catalog.settings.tutor.production
    SERVICE_VARIANT: enterprisecatalog
  volumes:
    - ../plugins/enterprisecatalog/apps/settings/tutor:/openedx/enterprise-catalog/enterprise_catalog/settings/tutor:ro
  restart: unless-stopped
  depends_on: 
    - lms
    {% if RUN_MYSQL %}- mysql{% endif %}

enterprisecatalog-worker:
  image: {{ ENTERPRISECATALOG_IMAGE }}
  command: celery -A enterprise_catalog worker --loglevel=INFO
  environment:
    DJANGO_SETTINGS_MODULE: enterprise_catalog.settings.tutor.production
    SERVICE_VARIANT: enterprisecatalog-worker
  restart: unless-stopped
  depends_on:
    {% if RUN_MYSQL %}- mysql{% endif %}
    - lms
    - redis
  volumes:
    - ../plugins/enterprisecatalog/apps/settings/tutor:/openedx/enterprise-catalog/enterprise_catalog/settings/tutor:ro
